            <td class="py-3 px-3 text-right font-mono font-extrabold ${row.isMe ? 'text-summit-400' : 'text-glacier-400'}">${scoreVal}</td>
          </tr>
        `;
      }).join('');
    }

    function updateMidnightCountdown() {
      const now = new Date();
      const midnight = new Date(now);
      midnight.setHours(24, 0, 0, 0);
      const diff = Math.max(0, midnight - now);
      const h = String(Math.floor(diff / 3600000)).padStart(2, '0');
      const m = String(Math.floor((diff % 3600000) / 60000)).padStart(2, '0');
      const s = String(Math.floor((diff % 60000) / 1000)).padStart(2, '0');
      document.getElementById('midnight-countdown').textContent = `${h}:${m}:${s}`;
    }

    window.addEventListener('DOMContentLoaded', () => {
      updateDynamicDateAndAnomaly();
